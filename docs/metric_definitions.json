{
  "schema_version": "common-research-metrics-v3",
  "foraging_episode": {"metric_name": "Foraging Episode", "unit": "scout-trip", "unit_of_analysis": "each started scout trip", "formula": "one row reconstructed from trip start through first delivery or global horizon", "source_fields": ["swarm_events.csv", "swarm_trajectory.csv:trip_id,trip_distance_m"], "inclusion_rule": "every observed started trip including incomplete trips at horizon", "exclusion_rule": "COLONY-only events and rows without a scout trip_id"},
  "outcome_funnel": {"metric_name": "Foraging Episode Funnel", "unit": "binary lifecycle stage per scout-trip", "unit_of_analysis": "foraging episode", "formula": "presence of RESOURCE_DETECTED, COLLECT, RETURN_HOME_START, NEST_REACHED, DELIVER", "source_fields": ["swarm_events.csv:event,scout_id,trip_id"], "inclusion_rule": "all foraging episodes", "exclusion_rule": "no success is inferred from phase alone"},
  "return_episode": {"metric_name": "Return Episode / Return Progress", "unit": "return episode", "unit_of_analysis": "each RETURN_HOME_START", "formula": "start/minimum/final Euclidean distance to the Scout home pose", "source_fields": ["swarm_events.csv:RETURN_HOME_START,NEST_REACHED,DELIVER", "swarm_trajectory.csv:x_m,y_m,sim_time_s"], "inclusion_rule": "all started returns including unfinished returns at horizon", "exclusion_rule": "no return is inferred without RETURN_HOME_START"},
  "coverage": {"metric_name": "Coverage", "unit": "0.5 m cells per scout-run", "unit_of_analysis": "scout-run", "formula": "count unique (floor(x_m/0.5), floor(y_m/0.5)) cells", "source_fields": ["swarm_trajectory.csv:x_m,y_m"], "inclusion_rule": "all active trajectory rows", "exclusion_rule": "no action is excluded; validity remains separately labelled"},
  "coverage_distance": {"metric_name": "Coverage versus Distance", "unit": "cells per metre", "unit_of_analysis": "scout-run", "formula": "coverage_cells / total_distance_m", "source_fields": ["coverage_distance_by_scout.csv:coverage_cells,total_distance_m"], "inclusion_rule": "all scout-runs with positive distance", "exclusion_rule": "zero-distance runs report 0 rather than divide by zero"},
  "nest_energy": {"metric_name": "Nest Energy versus Time", "unit": "energy units", "unit_of_analysis": "colony-run event", "formula": "cumulative delivered_energy; target reached when energy >= target", "source_fields": ["nest_energy_timeline.csv:timestamp,delivered_energy,new_energy,target"], "inclusion_rule": "all NEST_ENERGY_UPDATED events", "exclusion_rule": "no interpolation or controller feedback"},
  "mission_outcome": {"metric_name": "Final Nest Energy / Mission Outcome", "unit": "colony-run", "unit_of_analysis": "seed-run", "formula": "final nest_energy_units and recorded mission_outcome", "source_fields": ["swarm_summary.json:nest_energy_units,mission_outcome,termination_reason"], "inclusion_rule": "all completed runs", "exclusion_rule": "engineering validity is not collapsed into mission outcome"},
  "trips_deliveries": {"metric_name": "Trips and Deliveries per Scout", "unit": "counts per scout-run", "unit_of_analysis": "scout-run", "formula": "started/completed trips and observed lifecycle counts", "source_fields": ["swarm_summary.json:scouts", "swarm_events.csv"], "inclusion_rule": "all Scouts", "exclusion_rule": "no trip limit is implied in research mode"},
  "delivery_rate": {"metric_name": "Delivery Rate", "unit": "deliveries per 1000 s", "unit_of_analysis": "colony-run", "formula": "1000 * deliveries / actual_runtime_s", "source_fields": ["swarm_summary.json:simulation_time_s", "swarm_events.csv:DELIVER"], "inclusion_rule": "all completed runs", "exclusion_rule": "zero-duration runs report 0"},
  "energy_accumulation_rate": {"metric_name": "Energy Accumulation Rate", "unit": "energy units per 1000 s", "unit_of_analysis": "colony-run", "formula": "1000 * final_nest_energy_units / actual_runtime_s", "source_fields": ["swarm_summary.json:nest_energy_units,simulation_time_s"], "inclusion_rule": "all completed runs", "exclusion_rule": "zero-duration runs report 0"},
  "foraging_efficiency": {"metric_name": "Foraging Efficiency Rate", "unit": "coverage cells per metre and per minute", "unit_of_analysis": "scout-run", "formula": "coverage_cells/total_distance_m; 60*coverage_cells/active_time_s", "source_fields": ["coverage_distance_by_scout.csv"], "inclusion_rule": "all scout-runs", "exclusion_rule": "zero denominators report 0"},
  "revisit": {"metric_name": "Revisit", "unit": "trajectory samples per scout-run", "unit_of_analysis": "scout-run", "formula": "samples whose canonical 0.5 m cell was previously observed by that Scout", "source_fields": ["swarm_trajectory.csv:x_m,y_m"], "inclusion_rule": "all active trajectory samples", "exclusion_rule": "never fed into controller", "role": "passive only"},
  "repeated_local_behavior": {"metric_name": "Repeated Local Behavior", "unit": "consecutive samples per scout-run", "unit_of_analysis": "scout-run", "formula": "consecutive equal action labels within one canonical 0.5 m cell", "source_fields": ["swarm_trajectory.csv:action,x_m,y_m"], "inclusion_rule": "all active trajectory samples", "exclusion_rule": "never fed into controller", "role": "passive only"},
  "mechanism_compatibility": {"baseline_values": {"wm_enabled": false, "wm_hit_count": 0, "wm_intervention_count": 0, "em_enabled": false, "em_query_count": 0, "em_used_count": 0, "exchange_mode": "off", "encounter_count": 0, "exchange_count": 0, "received_experience_count": 0, "used_received_experience_count": 0, "aih_enabled": false, "aih_level": null, "aih_update_count": 0, "aih_influenced_decision_count": 0}}
}
